{
  "name": "rc-set-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "start:phone": "HOST=0.0.0.0 node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build.mjs && node scripts/migrate.mjs",
    "dev": "wrangler dev --config wrangler.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test",
    "sync:shopping": "node scripts/sync-shopping-list.mjs",
    "quote": "node scripts/quote.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "wrangler": "4.92.0"
  }
}
